{
  "name": "@floogic/ui",
  "version": "0.1.1",
  "description": "Floogic Design System",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/floogic-ui.umd.cjs",
  "module": "./dist/floogic-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/floogic-ui.es.js",
      "require": "./dist/floogic-ui.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./tokens/*": "./dist/tokens/*",
    "./style.css": "./dist/assets/stylex.css",
    "./llms.txt": "./.ai/llms.txt",
    "./llms-full.txt": "./.ai/llms-full.txt",
    "./ai-catalog.json": "./.ai/ai-catalog.json"
  },
  "bin": {
    "floogic-mcp": "./scripts/mcp-server.mjs",
    "floogic-ui": "./scripts/cli.mjs"
  },
  "files": [
    "dist",
    "scripts",
    ".ai",
    ".github",
    "COMPONENT_GUIDELINES.md",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && vite build && node scripts/generate-ai-metadata.mjs",
    "build:ai-metadata": "node scripts/generate-ai-metadata.mjs",
    "check:ai-compliance": "node scripts/validate-ai-code.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "yarn build && node scripts/publish.mjs"
  },
  "packageManager": "yarn@4.3.1",
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@stylexjs/stylex": "^0.19.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jsdom": "^30",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "5",
    "unplugin": "^3.3.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
